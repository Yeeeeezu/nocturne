<Window x:Class="Nocturne.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Nocturne.Ui"
        Title="nocturne"
        Background="#0d0d0f"
        Foreground="#e8e8f0"
        Width="900" Height="360"
        MinWidth="400" MinHeight="200"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResize">

  <Window.Resources>
    <Style x:Key="FlatBtn" TargetType="Button">
      <Setter Property="Background"   Value="Transparent"/>
      <Setter Property="Foreground"   Value="#6b6b80"/>
      <Setter Property="BorderBrush"  Value="Transparent"/>
      <Setter Property="Padding"      Value="8,4"/>
      <Setter Property="Cursor"       Value="Hand"/>
      <Setter Property="FontFamily"   Value="Consolas"/>
      <Setter Property="FontSize"     Value="13"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Foreground" Value="#e8e8f0"/>
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="38"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="36"/>
    </Grid.RowDefinitions>

    <!-- title bar / drag handle -->
    <Border Grid.Row="0" Background="#131316" MouseLeftButtonDown="TitleBar_MouseDown">
      <Grid>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
          <TextBlock Text="nocturne" FontFamily="Consolas" FontSize="14"
                     Foreground="#7c6af7" FontWeight="SemiBold"/>
          <TextBlock x:Name="StatusText" Text="  ·  idle" FontFamily="Consolas"
                     FontSize="12" Foreground="#6b6b80" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                    VerticalAlignment="Center" Margin="0,0,8,0">
          <Button Style="{StaticResource FlatBtn}" Content="─" Click="Minimize_Click"/>
          <Button Style="{StaticResource FlatBtn}" Content="✕" Click="Close_Click"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- visualizer -->
    <ui:VisualizerControl x:Name="Viz" Grid.Row="1" Margin="8,8,8,0"/>

    <!-- status bar -->
    <Border Grid.Row="2" Background="#131316"
            BorderBrush="#1e1e24" BorderThickness="0,1,0,0">
      <Grid Margin="16,0">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="ToggleBtn" Style="{StaticResource FlatBtn}"
                  Content="▶  start" Click="Toggle_Click"/>
          <TextBlock x:Name="PeakText" Text="" FontFamily="Consolas"
                     FontSize="11" Foreground="#6b6b80" VerticalAlignment="Center"
                     Margin="8,0,0,0"/>
        </StackPanel>
        <TextBlock Text="loopback capture · wasapi · experiment by claude"
                   HorizontalAlignment="Right" VerticalAlignment="Center"
                   FontFamily="Consolas" FontSize="10" Foreground="#2a2a33"/>
      </Grid>
    </Border>
  </Grid>
</Window>
